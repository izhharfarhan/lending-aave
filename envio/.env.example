# HyperSync API token: https://envio.dev/app/api-tokens
ENVIO_API_TOKEN="<YOUR-API-TOKEN>"
# Archive RPC per chain for the liquidation reads (comma-separated for fallbacks).
# Defaults to public endpoints when unset.
# ENVIO_RPC_URL_1=
# ENVIO_RPC_URL_8453=
# ENVIO_RPC_URL_42161=
# Start/end blocks per chain (defaults: 0 / head). Set a start block to bound the backfill.
# START_BLOCK_1=
# START_BLOCK_8453=
# START_BLOCK_42161=
# END_BLOCK_1=
# END_BLOCK_8453=
# END_BLOCK_42161=
