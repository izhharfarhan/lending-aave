{
  "name": "lending-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:fork": "node scripts/with-env.mjs .env.fork next dev -p 3200",
    "dev:mainnet": "node scripts/with-env.mjs .env.mainnet next dev -p 3200",
    "check:mainnet": "tsx --env-file=.env.mainnet scripts/check-mainnet.mts",
    "anvil:up": "node --env-file=.env.fork scripts/anvil-up.mjs",
    "build": "node scripts/with-env.mjs .env.fork next build",
    "fixture:position": "tsx scripts/position-fixture.mts",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:fork": "NODE_OPTIONS=--experimental-vm-modules jest -c jest.fork.config.ts --runInBand",
    "test:e2e": "playwright test",
    "e2e:serve": "NEXT_PUBLIC_FORK_PORT_OFFSET=20000 NEXT_PUBLIC_INDEXER_URL= NEXT_DIST_DIR=.next-e2e node scripts/with-env.mjs .env.fork sh -c 'rm -rf .next-e2e && next build && next start -p 3300'"
  },
  "dependencies": {
    "@bgd-labs/aave-address-book": "4.44.22",
    "@rainbow-me/rainbowkit": "2.2.11",
    "@tanstack/react-query": "^5.104.5",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "~2.57.11",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jest": "30.5.2",
    "tailwindcss": "^4",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.11.2"
}
