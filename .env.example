# Salin ke .env.fork dan .env.mainnet (dua-duanya di-ignore git).

# "fork" atau "mainnet"
NEXT_PUBLIC_APP_MODE=

# RPC per chain buat frontend di mode mainnet
NEXT_PUBLIC_RPC_URL_1=

# RPC ARCHIVE per chain buat `pnpm anvil:up` (non-archive ditolak; cuma di .env.fork, nggak ke browser)
ANVIL_FORK_URL_1=
