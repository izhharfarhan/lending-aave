# Salin ke .env.fork dan .env.mainnet (dua-duanya di-ignore git).

# "fork" atau "mainnet"
PONDER_MODE=

# RPC Ponder per chain. Fork: Anvil lending-web `pnpm anvil:up` (Ethereum :8555, Base :8556, Arbitrum :8557). Mainnet (tiket 25): key Alchemy
# TERPISAH dari app & fork (DECISIONS Q31), supaya kuota indexer yang habis nggak ikut mematikan keduanya.
PONDER_RPC_URL_1=
PONDER_RPC_URL_8453=
PONDER_RPC_URL_42161=

# Database beda per mode: .../lending_fork atau .../lending_mainnet (Postgres docker-compose, port host 5434).
DATABASE_URL=

# Blok awal index, cuma mode mainnet: blok terbaru saat indexer mulai (Q31). Fork selalu blok pin + 1 (src/chains.ts).
START_BLOCK_1=
START_BLOCK_8453=
START_BLOCK_42161=

# Untuk `pnpm test` (Anvil test sendiri, di-fork di blok pin). Harus RPC archive, sama dengan ANVIL_FORK_URL_* lending-web.
ANVIL_FORK_URL_1=
ANVIL_FORK_URL_8453=
ANVIL_FORK_URL_42161=
